{
  "schema_version": 2,
  "name": "lnako-benchmark-v2",
  "runtime_support": {
    "gonako": {
      "supported": true,
      "reason": "公式配布gonako 3.8.1をgonako run <source> [args...]で実行し、自己表示版・配布SHA-256をrunnerで記録する"
    }
  },
  "cases": [
    {
      "id": "startup-empty",
      "category": "startup",
      "kind": "startup",
      "description": "プログラム本体と標準出力を持たない最小起動",
      "measurement": "startup",
      "profiles": ["smoke", "normal", "full"],
      "tags": ["startup", "empty", "portable"],
      "source": "benchmarks/cases/startup/empty/source.nako3",
      "sources": {"lnako": "same", "cnako": "same", "gonako": "same"},
      "input": {"args": []},
      "expected_stdout": ""
    },
    {
      "id": "startup-hello",
      "category": "startup",
      "kind": "startup",
      "description": "最小の文字列表示までを含む起動",
      "measurement": "startup",
      "profiles": ["smoke", "normal", "full"],
      "tags": ["startup", "stdout", "portable"],
      "source": "benchmarks/cases/startup/hello/source.nako3",
      "sources": {"lnako": "same", "cnako": "same", "gonako": "same"},
      "input": {"args": []},
      "expected_stdout": "hello\n"
    },
    {
      "id": "integer-arithmetic",
      "category": "core",
      "kind": "micro",
      "description": "入力seedからLCGを100000回更新し、途中値の剰余を合計する",
      "measurement": "steady_state",
      "profiles": ["smoke", "normal", "full"],
      "tags": ["integer", "loop", "runtime-input", "cross-language", "portable"],
      "source": "benchmarks/cases/core/integer-arithmetic/source.nako3",
      "sources": {
        "lnako": "same",
        "cnako": "same",
        "gonako": "benchmarks/cases/core/integer-arithmetic/gonako.nako3",
        "python": "benchmarks/cases/core/integer-arithmetic/ref.py",
        "c": "benchmarks/cases/core/integer-arithmetic/ref.c",
        "rust": "benchmarks/cases/core/integer-arithmetic/ref.rs"
      },
      "runtime_support": {
        "gonako": {
          "supported": true,
          "source_equivalence": "same-workload",
          "reason": "gonakoの直接コマンドライン添字構文をARGS配列の代入へ置き換えた同一workload"
        }
      },
      "input": {"args": ["12345", "100000"]},
      "expected_stdout": "49913894\n"
    },
