{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soramikan/lnako/package-system/schema/npkg-metadata/v1",
  "type": "object",
  "required": ["schemaVersion", "package"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/packageId" },
        "name": { "$ref": "common.schema.json#/$defs/packageName" },
        "version": { "$ref": "common.schema.json#/$defs/semver" },
        "license": { "type": "string" },
        "description": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "nako-version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "min-nako-version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/packageRuntimeName" }
        },
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nako": { "$ref": "common.schema.json#/$defs/semverRange" },
            "cnako": { "$ref": "common.schema.json#/$defs/semverRange" },
            "lnako": { "$ref": "common.schema.json#/$defs/semverRange" }
          }
        }
      }
    },
    "exports": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/exportEntry" }
    },
    "dependencies": {
      "$ref": "common.schema.json#/$defs/dependencyGroup"
    },
    "features": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/featureList" },
      "propertyNames": { "$ref": "common.schema.json#/$defs/featureName" }
    },
    "nativePluginAbi": {
      "type": "string",
      "enum": ["lnako_plugin_v1"]
    }
  }
}
