{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soramikan/lnako/package-system/schema/nako.toml/v1",
  "type": "object",
  "required": [
    "package"
  ],
  "additionalProperties": false,
  "properties": {
    "package": {
      "type": "object",
      "required": [
        "name",
        "version",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/packageName"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "license": {
          "type": "string"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/packageId"
        },
        "description": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "nako-version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "min-nako-version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "schema-version": {
          "type": "integer",
          "minimum": 1
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/packageRuntimeName"
          }
        },
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nako": {
              "$ref": "common.schema.json#/$defs/semverRange"
            },
            "cnako": {
              "$ref": "common.schema.json#/$defs/semverRange"
            },
            "lnako": {
              "$ref": "common.schema.json#/$defs/semverRange"
            }
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/featureList"
      },
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/featureName"
      }
    },
    "dependencies": {
      "$ref": "common.schema.json#/$defs/dependencyGroup"
    },
    "dev-dependencies": {
      "$ref": "common.schema.json#/$defs/dependencyGroup"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/profile"
      },
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/featureName"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/exportEntry"
      }
    }
  }
}
