{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soramikan/lnako/package-system/schema/nako.toml/v1",
  "type": "object",
  "required": ["package"],
  "additionalProperties": false,
  "$defs": {
    "dependencyGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pkg": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["version"],
            "additionalProperties": false,
            "properties": {
              "version": { "$ref": "common.schema.json#/$defs/semverRange" },
              "features": { "$ref": "common.schema.json#/$defs/featureList" },
              "default-features": { "type": "boolean" },
              "profile": { "type": "string" },
              "alias": { "type": "string" },
              "public-id": { "$ref": "common.schema.json#/$defs/packageId" }
            }
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        },
        "npm": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "common.schema.json#/$defs/semverRange" },
              {
                "type": "object",
                "required": ["version"],
                "additionalProperties": false,
                "properties": {
                  "version": { "$ref": "common.schema.json#/$defs/semverRange" },
                  "context": { "type": "string" },
                  "features": { "$ref": "common.schema.json#/$defs/featureList" },
                  "peer-dependencies": {
                    "type": "object",
                    "additionalProperties": { "$ref": "common.schema.json#/$defs/semverRange" }
                  },
                  "optional-peers": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            ]
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        },
        "path": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "mutable": { "type": "boolean" }
            }
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        },
        "git": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["url", "commit"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
              "path": { "type": "string" },
              "alias": { "type": "string" }
            }
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        },
        "http": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["url", "hash"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "hash": { "$ref": "common.schema.json#/$defs/hash" },
              "alias": { "type": "string" }
            }
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "properties": {
    "package": {
      "type": "object",
      "required": ["name", "version", "license"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/packageName" },
        "version": { "$ref": "common.schema.json#/$defs/semver" },
        "license": { "type": "string" },
        "id": { "$ref": "common.schema.json#/$defs/packageId" },
        "description": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "nako-version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "min-nako-version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "schema-version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/featureList" },
      "propertyNames": { "$ref": "common.schema.json#/$defs/featureName" }
    },
    "dependencies": {
      "$ref": "#/$defs/dependencyGroup"
    },
    "dev-dependencies": {
      "$ref": "#/$defs/dependencyGroup"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/profile" },
      "propertyNames": { "$ref": "common.schema.json#/$defs/featureName" }
    },
    "exports": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/exportEntry" }
    }
  }
}
