{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soramikan/lnako/package-system/schema/common/v1",
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^pkg:[0-9a-f]{32}$"
    },
    "humanId": {
      "type": "string",
      "pattern": "^@[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "minLength": 1
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "semverRange": {
      "type": "string"
    },
    "featureName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "featureList": {
      "type": "array",
      "items": { "$ref": "#/$defs/featureName" }
    },
    "osName": {
      "type": "string"
    },
    "cpuName": {
      "type": "string"
    },
    "abiName": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": ["os", "cpu", "abi"],
      "additionalProperties": false,
      "properties": {
        "os": { "$ref": "#/$defs/osName" },
        "cpu": { "$ref": "#/$defs/cpuName" },
        "abi": { "$ref": "#/$defs/abiName" }
      }
    },
    "runtimeName": {
      "type": "string"
    },
    "packageRuntimeName": {
      "type": "string",
      "enum": ["lnako", "cnako"]
    },
    "profile": {
      "type": "object",
      "required": ["os", "cpu", "abi"],
      "additionalProperties": false,
      "properties": {
        "runtime": { "$ref": "#/$defs/runtimeName" },
        "os": { "$ref": "#/$defs/osName" },
        "cpu": { "$ref": "#/$defs/cpuName" },
        "abi": { "$ref": "#/$defs/abiName" },
        "compat-js": { "type": "boolean" },
        "optimize": {
          "type": "string",
          "enum": ["O0", "O1", "O2", "O3"]
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^(sha256-[A-Za-z0-9+/]{43}=|sha512-[A-Za-z0-9+/]{86}=|sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "sha256Hash": {
      "type": "string",
      "pattern": "^(sha256-[A-Za-z0-9+/]{43}=|sha256:[0-9a-f]{64}|[0-9a-f]{64})$"
    },
    "artifactRecord": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["tar.gz", ".npkg", "raw", "npm-tarball"]
        },
        "sha256": { "$ref": "#/$defs/hash" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "npmInstance": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "$ref": "#/$defs/semver" },
        "context": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hash" },
        "url": { "type": "string", "format": "uri" },
        "peerDependencies": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/semverRange" }
        }
      }
    },
    "sourceRegistry": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "registry" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "sourceStatic": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "static" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "sourceGit": {
      "type": "object",
      "required": ["type", "url", "commit"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "git" },
        "url": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string" }
      }
    },
    "sourceHttp": {
      "type": "object",
      "required": ["type", "url", "hash"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "http" },
        "url": { "type": "string", "format": "uri" },
        "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "sourcePath": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "path" },
        "path": { "type": "string" },
        "mutable": { "type": "boolean" }
      }
    },
    "artifactDecl": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "when": { "type": "string" },
        "min-os": { "type": "string" },
        "libc": { "type": "string" },
        "features": { "$ref": "#/$defs/featureList" }
      }
    },
    "artifactRef": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/artifactDecl" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/artifactDecl" }
            ]
          }
        }
      ]
    },
    "exportEntry": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "alias": { "type": "string" },
        "native": { "$ref": "#/$defs/artifactRef" },
        "esm": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "dependencyGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pkg": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["version"],
            "additionalProperties": false,
            "properties": {
              "version": { "$ref": "#/$defs/semverRange" },
              "features": { "$ref": "#/$defs/featureList" },
              "default-features": { "type": "boolean" },
              "profile": { "type": "string" },
              "alias": { "type": "string" },
              "public-id": { "$ref": "#/$defs/packageId" },
              "prefer-native": { "type": "boolean" }
            }
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        },
        "npm": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/semverRange" },
              {
                "type": "object",
                "required": ["version"],
                "additionalProperties": false,
                "properties": {
                  "version": { "$ref": "#/$defs/semverRange" },
                  "context": { "type": "string" },
                  "features": { "$ref": "#/$defs/featureList" },
                  "peer-dependencies": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/$defs/semverRange" }
                  },
                  "optional-peers": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            ]
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        },
        "path": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "mutable": { "type": "boolean" }
            }
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        },
        "git": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["url", "commit"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
              "path": { "type": "string" },
              "alias": { "type": "string" }
            }
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        },
        "http": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["url", "hash"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "hash": { "$ref": "#/$defs/hash" },
              "alias": { "type": "string" }
            }
          },
          "propertyNames": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
