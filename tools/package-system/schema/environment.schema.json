{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soramikan/lnako/package-system/schema/environment/v1",
  "type": "object",
  "required": ["schemaVersion", "lockSha256", "profile", "runtime", "packages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "lockSha256": {
      "$ref": "common.schema.json#/$defs/sha256Hash"
    },
    "profile": {
      "type": "string"
    },
    "runtime": {
      "$ref": "common.schema.json#/$defs/packageRuntimeName"
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "version", "path"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/packageName" },
          "version": { "$ref": "common.schema.json#/$defs/semver" },
          "id": { "$ref": "common.schema.json#/$defs/packageId" },
          "path": { "type": "string" },
          "exports": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/exportEntry" }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "args": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "josi": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "fn": { "type": "string" },
                "variable": { "type": "boolean" },
                "async": { "type": "boolean" },
                "return": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
