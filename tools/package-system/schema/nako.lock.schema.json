{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soramikan/lnako/package-system/schema/nako.lock/v1",
  "type": "object",
  "required": ["schemaVersion", "resolverVersion", "input", "packages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "resolverVersion": {
      "type": "integer",
      "minimum": 1
    },
    "input": {
      "type": "object",
      "required": ["manifestSha256", "profile", "features", "target"],
      "additionalProperties": false,
      "properties": {
        "manifestSha256": { "type": "string" },
        "profile": { "type": "string" },
        "features": { "$ref": "common.schema.json#/$defs/featureList" },
        "target": { "$ref": "common.schema.json#/$defs/target" },
        "runtime": {
          "description": "解決に使った runtime（lnako/cnako）。--runtime 切替を lock 鮮度で検出するための入力。",
          "type": "string"
        },
        "nakoVersion": {
          "description": "engines 照合に使った互換なでしこ version。バイナリ更新時の再解決に使う鮮度入力。",
          "type": "string"
        },
        "cnakoVersion": {
          "description": "engines 照合に使った cnako version。",
          "type": "string"
        },
        "lnakoVersion": {
          "description": "engines 照合に使った lnako version。",
          "type": "string"
        },
        "mutablePaths": {
          "description": "mutable = true path 依存の内容 digest（path 昇順）。宣言 dir の内容変更を lock 鮮度入力として記録する。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "packages": { "$ref": "#/$defs/packageMap" },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/profile" },
      "propertyNames": { "$ref": "common.schema.json#/$defs/featureName" }
    },
    "profilePackages": {
      "description": "profile ごとの解決済 package グラフ。複数 profile を一つの lock に収録するとき、input.profile 以外の選択肢もここへ記録する。",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/packageMap" },
      "propertyNames": { "$ref": "common.schema.json#/$defs/featureName" }
    }
  },
  "$defs": {
    "packageMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/packageEntry" },
      "propertyNames": { "$ref": "common.schema.json#/$defs/packageId" }
    },
    "packageEntry": {
      "type": "object",
      "required": ["id", "name", "version", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/packageId" },
        "name": { "type": "string" },
        "version": { "$ref": "common.schema.json#/$defs/semver" },
        "source": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/sourceRegistry" },
            { "$ref": "common.schema.json#/$defs/sourceStatic" },
            { "$ref": "common.schema.json#/$defs/sourceGit" },
            { "$ref": "common.schema.json#/$defs/sourceHttp" },
            { "$ref": "common.schema.json#/$defs/sourcePath" }
          ]
        },
        "resolvedFrom": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/sourceRegistry" },
            { "$ref": "common.schema.json#/$defs/sourceStatic" },
            { "$ref": "common.schema.json#/$defs/sourceGit" },
            { "$ref": "common.schema.json#/$defs/sourceHttp" },
            { "$ref": "common.schema.json#/$defs/sourcePath" }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/packageId" }
        },
        "features": { "$ref": "common.schema.json#/$defs/featureList" },
        "implementation": {
          "description": "解決時に選択された実装種別。共通 source 既定・native 明示選択の結果を記録する。",
          "type": "string",
          "enum": ["source", "native", "ESM", "none"]
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": { "$ref": "common.schema.json#/$defs/artifactRecord" },
          "propertyNames": { "type": "string" }
        },
        "npmInstances": {
          "type": "object",
          "additionalProperties": { "$ref": "common.schema.json#/$defs/npmInstance" }
        }
      }
    }
  }
}
