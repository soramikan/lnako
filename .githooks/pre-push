#!/bin/sh
# Read-only pre-push validation for lnako.
# Enable with: git config core.hooksPath .githooks

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

zero_sha=0000000000000000000000000000000000000000
pushing_branch=false

# Validate every branch ref in this push. Tags and other refs do not run the
# repository validation, but a non-fast-forward branch update is always
# rejected before any expensive command starts.
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/*)
            pushing_branch=true
            if [ "$local_sha" = "$zero_sha" ]; then
                echo "pre-push: branch deletion is not allowed" >&2
                exit 1
            fi
            if [ "$remote_sha" != "$zero_sha" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                echo "pre-push: non-fast-forward push is not allowed" >&2
                exit 1
            fi
            ;;
    esac
done

if [ "$pushing_branch" != "true" ]; then
    exit 0
fi

# Do not let the hook stage or commit generated evidence, and do not run
# validation against a checkout that contains unrelated local changes.
status_output=$(git status --porcelain=v1 --untracked-files=all) || {
    echo "pre-push: unable to inspect working tree status" >&2
    exit 1
}
if [ -n "$status_output" ]; then
    echo "pre-push: working tree is not clean; commit or stash changes first" >&2
    exit 1
fi

if ! ZIG=$(command -v zig 2>/dev/null); then
    echo "pre-push: zig not found in PATH" >&2
    exit 1
fi

# Prefer the repository's verified Node 24.15.0 toolchain when it is present.
# A normal installed node remains a valid fallback for developer machines that
# have not downloaded the repository toolchain yet.
NODE=
for candidate in \
    "$root/.cache/toolchains/node-24.15.0/bin/node" \
    "$root/.cache/toolchains/node-24.15.0/bin/node.exe" \
    "$root/.cache/toolchains/node-24.15.0/node.exe"; do
    if [ -x "$candidate" ]; then
        NODE=$candidate
        break
    fi
done
if [ -z "$NODE" ]; then
    if ! NODE=$(command -v node 2>/dev/null); then
        echo "pre-push: node not found in PATH and repository Node 24.15.0 is unavailable" >&2
        exit 1
    fi
fi

echo "pre-push: running zig build fmt-check..." >&2
"$ZIG" build fmt-check

echo "pre-push: running zig build test..." >&2
"$ZIG" build test

echo "pre-push: checking compatibility evidence provenance..." >&2
"$NODE" tools/sync_compat_evidence.mjs --check

echo "pre-push: checking interpreter-only classification..." >&2
"$NODE" tools/check_interpreter_only_classification.mjs --check
